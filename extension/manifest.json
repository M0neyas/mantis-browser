{
  "manifest_version": 2,
  "name": "Mantis",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "mantis@mantis.browser"
    }
  },
  "permissions": [
    "alarms",
    "notifications",
    "search",
    "storage",
    "topSites",
    "nativeMessaging",
    "proxy",
    "tabs",
    "menus",
    "history", "bookmarks",
    "sessions",
    "dns",
    "networkStatus",
    "downloads",
    "contextualIdentities",
    "clipboardWrite",
    "theme",
    "<all_urls>"
  ],
  "commands": {
    "copy-without-diacritics": {
      "suggested_key": { "default": "Ctrl+Shift+U" },
      "description": "__MSG_tools_unaccentCommand__"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "background": {
    "scripts": [
      "i18n.js",
      "version.js",
      "background.js",
      "vpn.js",
      "forget.js",
      "volume.js",
      "sensitive.js",
      "doh.js",
      "sync.js",
      "otherbrowser.js",
      "tools.js",
      "currency.js",
      "eshops.js",
      "tabsleep.js",
      "performance.js",
      "appearance.js"
    ],
    "persistent": true
  },
  "icons": {
    "48": "icons/mantis.svg",
    "96": "icons/mantis.svg"
  },
  "browser_action": {
    "default_title": "VPN",
    "default_icon": "icons/vpn-off.svg",
    "default_popup": "vpn/popup.html",
    "default_area": "navbar"
  },
  "page_action": {
    "default_title": "__MSG_other_openInOther__",
    "default_icon": "icons/other-browser.svg",
    "default_popup": "otherbrowser/popup.html"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "mantisPrefs": {
      "schema": "experiments/mantis.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "experiments/mantis.js",
        "paths": [
          [
            "mantisPrefs"
          ]
        ]
      }
    }
  }
}
